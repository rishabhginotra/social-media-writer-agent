{
  "metadata": {
    "suite_name": "NovaPulse Social Media Writer Agent — Golden Evaluation Dataset",
    "version": "1.0.0",
    "minimum_passing_score": 0.95
  },
  "test_cases": [
    {
      "case_id": "eval_001_linkedin_founder_finops",
      "description": "Founder/CEO LinkedIn post targeting Enterprise CTOs on Kubernetes FinOps with PulseGrid",
      "user_prompt": "Write a LinkedIn post from our Founder & CEO targeting Enterprise CTOs about cutting multi-cloud Kubernetes waste with PulseGrid to drive lead generation.",
      "author_persona": "founder_ceo",
      "audience_segment_id": "enterprise_cto_vp_eng",
      "platform": "linkedin",
      "product_line": "PulseGrid",
      "intended_outcome": "lead_generation",
      "human_approval_confirmed": false,
      "expected_trajectory": [
        "fetch_crm_audience_segment_insights",
        "query_marketing_campaign_value_propositions",
        "retrieve_historic_social_post_benchmarks",
        "validate_draft_against_brand_guidelines",
        "publish_approved_social_media_post"
      ],
      "expected_min_compliance_score": 90,
      "expected_publication_status": "pending_human_confirmation",
      "required_substrings": ["PulseGrid", "41%", "#NovaPulse"]
    },
    {
      "case_id": "eval_002_linkedin_architect_zerotrust",
      "description": "Chief Cloud Architect LinkedIn technical post on eBPF Zero-Trust Security with PulseShield",
      "user_prompt": "Draft a deeply technical LinkedIn post as our Chief Cloud Architect for Platform SREs about replacing sidecar proxies with PulseShield eBPF zero-trust security for our product launch.",
      "author_persona": "chief_architect",
      "audience_segment_id": "platform_sre_architects",
      "platform": "linkedin",
      "product_line": "PulseShield",
      "intended_outcome": "product_launch",
      "human_approval_confirmed": true,
